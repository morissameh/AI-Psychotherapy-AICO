{
  "base_model_id": "vilsonrodrigues/falcon-7b-instruct-sharded",
  "dataset_id": "heliosbrahma/mental_health_chatbot_dataset",
  "dataset_split": "train",
  "dataset_text_field": "text",
  "verified_dataset_size": 172,
  "output_dir": "outputs/falcon-lora-adapter",
  "load_in_4bit": true,
  "bnb_4bit_quant_type": "nf4",
  "bnb_4bit_use_double_quant": true,
  "bnb_4bit_compute_dtype": "float16",
  "lora_rank": 32,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "target_modules": [
    "query_key_value",
    "dense",
    "dense_h_to_4h",
    "dense_4h_to_h"
  ],
  "per_device_train_batch_size": 16,
  "gradient_accumulation_steps": 4,
  "optimizer": "paged_adamw_32bit",
  "learning_rate": 0.0002,
  "max_steps": 180,
  "max_grad_norm": 0.3,
  "warmup_ratio": 0.03,
  "lr_scheduler_type": "cosine",
  "max_sequence_length": 256,
  "fp16": true,
  "logging_steps": 10,
  "save_steps": 10,
  "group_by_length": true
}
